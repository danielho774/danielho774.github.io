# NBA API Configuration
# Copy this file to .env.local and fill in with your actual API credentials

# API Base URL
# Example for RapidAPI NBA: https://api-nba-v1.p.rapidapi.com
VITE_API_URL=https://your-api-url.com

# API Key
# Get this from your chosen API provider (RapidAPI, ESPN, etc.)
VITE_API_KEY=your-api-key-here

# API Provider
# Options: rapidapi, espn, api-basketball, custom
VITE_API_PROVIDER=rapidapi

# Environment
VITE_ENV=development
